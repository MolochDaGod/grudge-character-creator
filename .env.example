# ── Frontend (Vite env vars, must start with VITE_) ──────────

# R2 asset CDN base URL (leave empty for local dev)
# Production: https://assets.grudge-studio.com
VITE_R2_BASE_URL=

# D1 manifest Worker API URL (leave empty to use bundled data)
# Production: https://models.grudge-studio.com
VITE_MANIFEST_API=

# Grudge backend API URL
# Production: https://api.grudge-studio.com
VITE_GRUDGE_API=https://api.grudge-studio.com

# ── Backend API (api/ serverless functions) ───────────────────

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=

# Upstash Redis REST API (character storage)
# Copy these from your Upstash database dashboard → REST API section.
# Database: credible-moth-144383.upstash.io
UPSTASH_REDIS_REST_URL=https://credible-moth-144383.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare (for wrangler/scripts) ────────────────────────

# R2 credentials (for upload script --sdk mode)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=grudge-assets

# FBX source directory (for convert script)
FBX_SOURCE_DIR=F:\Documents\Toon_RTS\Toon_RTS
