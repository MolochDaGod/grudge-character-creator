{
  "name": "grudge-character-creator",
  "version": "2.0.0",
  "private": true,
  "description": "Grudge Studio — Modular 3D Race Character Creator with Grudge UUID, R2, and D1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite build && node server.js",
    "serve:only": "node server.js",
    "convert": "node scripts/convert-models.mjs",
    "upload": "node scripts/upload-r2.mjs",
    "seed": "node scripts/seed-d1.mjs",
    "d1:init": "npx wrangler d1 execute grudge-models --file=d1/schema.sql",
    "d1:init:local": "npx wrangler d1 execute grudge-models --local --file=d1/schema.sql",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "vite": "^5.4.0",
    "wrangler": "^4.0.0"
  }
}
